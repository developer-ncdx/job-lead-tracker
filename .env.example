# Browser-safe values used by the React application.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_AUTH_MODE=public

# Server-only values used by scripts/sync-job-leads.mjs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional in public mode. Set to an auth.users UUID in authenticated mode.
JOB_LEADS_OWNER_ID=

# Required by the protected Vercel cron endpoint. Use at least 16 random
# characters and configure the same value in the Vercel project.
CRON_SECRET=

JOB_LINKEDIN_TIMESTAMP_BACKFILL_LIMIT=6

# Optional comma-separated public feeds to skip in a specific environment.
JOB_DISABLED_PUBLIC_FEEDS=

# Optional SMTP failure notifications. These credentials only send notifications;
# no Gmail mailbox is scanned. Use an app password, never a normal account password.
JOB_ALERT_EMAIL_USER=your-gmail-address@gmail.com
JOB_ALERT_EMAIL_APP_PASSWORD=replace-with-your-16-character-app-password
JOB_SYNC_FAILURE_EMAIL_TO=noxpwr@gmail.com
JOB_SYNC_SMTP_HOST=smtp.gmail.com
JOB_SYNC_SMTP_PORT=465
JOB_SYNC_SMTP_SECURE=true

# Optional broad global job search. Request at https://jooble.org/api/about.
JOOBLE_API_KEY=
# Optional higher rate limit. Register at https://www.themuse.com/developers.
THE_MUSE_API_KEY=

# Optional overrides.
JOB_SOURCES_CONFIG=job-sources.config.json
JOB_SYNC_INTERVAL_MINUTES=60
