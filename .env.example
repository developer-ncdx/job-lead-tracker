# Browser-safe values used by the React application.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_AUTH_MODE=public

# Server-only values used by scripts/sync-job-leads.mjs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional in public mode. Set to an auth.users UUID in authenticated mode.
JOB_LEADS_OWNER_ID=

# Required by the protected Vercel cron endpoint. Use at least 16 random
# characters and configure the same value in the Vercel project.
CRON_SECRET=

# Gmail IMAP source for LinkedIn, Indeed, and OnlineJobs.ph job-alert emails.
# Copy these values to .env. Use a Gmail app password for the password field,
# not the normal Google account password. Never commit the real app password.
JOB_ALERT_EMAIL_ENABLED=true
JOB_ALERT_IMAP_HOST=imap.gmail.com
JOB_ALERT_IMAP_PORT=993
JOB_ALERT_IMAP_SECURE=true
JOB_ALERT_EMAIL_USER=noxpwr@gmail.com
JOB_ALERT_EMAIL_APP_PASSWORD=replace-with-your-16-character-gmail-app-password
JOB_ALERT_MAILBOX=INBOX
JOB_ALERT_LOOKBACK_DAYS=14
JOB_ALERT_MAX_MESSAGES=100

# Optional broad global job search. Request at https://jooble.org/api/about.
JOOBLE_API_KEY=
# Optional higher rate limit. Register at https://www.themuse.com/developers.
THE_MUSE_API_KEY=

# Optional overrides.
JOB_SOURCES_CONFIG=job-sources.config.json
JOB_SYNC_INTERVAL_MINUTES=60
