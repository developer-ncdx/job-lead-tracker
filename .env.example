# Browser-safe values used by the React application.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_AUTH_MODE=public

# Server-only values used by scripts/sync-job-leads.mjs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional in public mode. Set to an auth.users UUID in authenticated mode.
JOB_LEADS_OWNER_ID=

# Optional broad global job search. Request at https://jooble.org/api/about.
JOOBLE_API_KEY=
# Optional higher rate limit. Register at https://www.themuse.com/developers.
THE_MUSE_API_KEY=

# Optional overrides.
JOB_SOURCES_CONFIG=job-sources.config.json
JOB_SYNC_INTERVAL_MINUTES=60
